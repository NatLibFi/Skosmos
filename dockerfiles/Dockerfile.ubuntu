ARG COMPOSER_VERSION=2.9
ARG NODE_VERSION=24
ARG BUILD_ENV=production

# Stage 1: Install composer packages
FROM composer:${COMPOSER_VERSION} AS composer-installer

ARG BUILD_ENV
WORKDIR /app
COPY composer.json /app/

RUN composer install \
      --ignore-platform-req=ext-intl \
      --ignore-platform-req=ext-xsl \
      --ignore-platform-req=php \
      --no-autoloader \
      $( [ "$BUILD_ENV" = "production" ] && echo "--no-dev" )

# Stage 2: Install Node dependencies
ARG NODE_VERSION
FROM node:${NODE_VERSION}-alpine AS npm-installer

ARG BUILD_ENV
WORKDIR /usr/src/app
COPY package.json ./

# install node.js dependencies (and omit dev dependencies if BUILD_ENV is production)
RUN npm install --ignore-scripts \
    $( [ "$BUILD_ENV" = "production" ] && echo "--omit=dev" )

# Stage 3: Build base runtime image
FROM ubuntu:24.04 AS runtime

LABEL maintainer="National Library of Finland"
LABEL version="0.1"
LABEL description="A Docker image for Skosmos with Apache httpd."

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    apache2 \
    curl \
    libapache2-mod-php8.3 \
    locales \
    php8.3 \
    php8.3-curl \
    php8.3-xsl \
    php8.3-intl \
    php8.3-mbstring \
    php-apcu \
    php-zip \
    unzip \
 && rm -rf /var/lib/apt/lists/*

# https://stackoverflow.com/a/28406007
# fixes warnings like perl: warning: Setting locale failed.
RUN sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    locale-gen \
        ar_AE.utf8 \
        da_DK.utf8 \
        de_DE.utf8 \
        en_GB.utf8 \
        en_US.utf8 \
        es_ES.utf8 \
        fa_IR.utf8 \
        fi_FI.utf8 \
        fr_FR.utf8 \
        it_IT.utf8 \
        nb_NO.utf8 \
        nl_NL.utf8 \
        nn_NO.utf8 \
        pl_PL.utf8 \
        pt_PT.utf8 \
        pt_BR.utf8 \
        ru_RU.utf8 \
        sv_SE.utf8 \
        zh_CN.utf8
ENV LANGUAGE=en_US:en  
ENV LC_ALL=en_US.UTF-8 
ENV LANG=en_US.UTF-8  

# timezone
RUN sed -i 's/;date.timezone =/date.timezone = "UTC"/g' /etc/php/8.3/apache2/php.ini

COPY dockerfiles/config/000-default.conf /etc/apache2/sites-available/000-default.conf

RUN a2enmod \
        rewrite \
        expires

# set ServerName & redirect error log to stderr for docker logs
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf && \
        sed -ri \
        -e 's!^(\s*ErrorLog)\s+\S+!\1 /proc/self/fd/1!g' \
        "/etc/apache2/apache2.conf"

WORKDIR /var/www/html
RUN rm index.html

EXPOSE 80

CMD ["/usr/sbin/apache2ctl", "-D", "FOREGROUND"]

# Stage 4a: Finalize development runtime image
FROM runtime AS development

# Install Node.js matching the version used in npm stages
ARG NODE_VERSION
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    gnupg \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
 && apt-get update \
 && apt-get install -y nodejs \
        libgtk-3-0t64 \
        libgbm-dev \
        libnotify-dev \
        libnss3 \
        libxss1 \
        libasound2t64 \
        libxtst6 \
        xauth \
        xvfb \
 && rm -rf /var/lib/apt/lists/*

 # Composer vendors and Node modules from previous stages
COPY --from=composer-installer /app/vendor /var/www/html/vendor
COPY --from=npm-installer /usr/src/app/node_modules /var/www/html/node_modules

# install cypress before copying sources
RUN npx cypress install

# all source files including tests
COPY . /var/www/html/

# Configure Skosmos
COPY dockerfiles/config/config-docker.ttl /var/www/html/config.ttl

# Generate the Composer autoloader now that the sources are present
COPY --from=composer-installer /usr/bin/composer /usr/bin/composer
RUN composer dump-autoload --ignore-platform-req=php

# Stage 4b: Finalize production runtime image
FROM runtime AS production

# Composer vendors and Node modules from previous stages
COPY --from=composer-installer /app/vendor /var/www/html/vendor
COPY --from=npm-installer /usr/src/app/node_modules /var/www/html/node_modules

# sources (only production files)
COPY bin /var/www/html/bin
COPY config /var/www/html/config
COPY custom-templates /var/www/html/custom-templates
COPY plugins /var/www/html/plugins
COPY resource /var/www/html/resource
COPY src /var/www/html/src
COPY .env /var/www/html
COPY .htaccess /var/www/html
COPY composer.json /var/www/html
COPY config.ttl.dist /var/www/html
COPY favicon.ico /var/www/html
COPY swagger.json /var/www/html

# Generate the Composer autoloader now that the sources are present
COPY --from=composer-installer /usr/bin/composer /usr/bin/composer
RUN composer dump-autoload --no-dev --ignore-platform-req=php

HEALTHCHECK --interval=5s --timeout=3s --retries=3 CMD curl -f http://localhost || exit 1
